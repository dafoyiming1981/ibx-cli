{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Total DNS Zones",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "count(count by (zone) (ibx_dns_records_count))",
          "legendFormat": "Zones",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      }
    },
    {
      "id": 2,
      "title": "Total DNS Records",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(ibx_dns_records_count)",
          "legendFormat": "Records",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "Record Types",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "count(count by (type) (ibx_dns_records_count))",
          "legendFormat": "Types",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      }
    },
    {
      "id": 4,
      "title": "Records per Zone",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (zone) (ibx_dns_records_count)",
          "legendFormat": "{{zone}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Top Zones by Record Count",
      "type": "bargauge",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "topk(10, sum by (zone) (ibx_dns_records_count))",
          "legendFormat": "{{zone}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 6,
      "title": "DNS Records by Type",
      "type": "piechart",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (type) (ibx_dns_records_count)",
          "legendFormat": "{{type}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 7,
      "title": "DNS Records by Zone and Type",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "ibx_dns_records_count",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "align": "auto" }
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": {
              "zone": "Zone",
              "type": "Record Type",
              "Value": "Count",
              "view": "View"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "A Records per Zone",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (zone) (ibx_dns_records_count{type=\"A\"})",
          "legendFormat": "{{zone}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 9,
      "title": "CNAME Records per Zone",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (zone) (ibx_dns_records_count{type=\"CNAME\"})",
          "legendFormat": "{{zone}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 10,
      "title": "DNS Records Trend",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 34 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (zone) (ibx_dns_records_count)",
          "legendFormat": "{{zone}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["infoblox", "dns", "records"],
  "templating": {
    "list": [
      {
        "name": "zone",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(ibx_dns_records_count, zone)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "label": "Zone"
      },
      {
        "name": "type",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(ibx_dns_records_count, type)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "label": "Record Type"
      },
      {
        "name": "view",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(ibx_dns_records_count, view)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "label": "DNS View"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Infoblox DNS Records",
  "uid": "ibx-dns-records",
  "version": 1
}
