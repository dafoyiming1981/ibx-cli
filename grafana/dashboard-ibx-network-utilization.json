{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Total Networks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "count(max by (network) (ibx_network_utilization_percent{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"}))",
          "legendFormat": "Networks",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Average Utilization",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "avg(max by (network) (ibx_network_utilization_percent{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"}))",
          "legendFormat": "Avg %",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "High Utilization (>80%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "count(max by (network) (ibx_network_utilization_percent{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"}) > 80)",
          "legendFormat": "Count",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Total IPs in Use",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(max by (network) (ibx_network_used_ips{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"}))",
          "legendFormat": "IPs",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "title": "Network Utilization Table",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max by (network, vlan, zone, site, members, auto_provision, l2, comment) (ibx_network_utilization_percent{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"}) * on(network) group_left(ip1, ip2, ip3) max by (network, ip1, ip2, ip3) (ibx_network_next_available_ip) or (max by (network, vlan, zone, site, members, auto_provision, l2, comment) (ibx_network_utilization_percent{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"}) unless on(network) max by (network) (ibx_network_next_available_ip))",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          },
          "custom": {
            "cellOptions": { "type": "color-background" },
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              { "id": "displayName", "value": "Usage %" },
              { "id": "unit", "value": "percent" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ip1" },
            "properties": [{ "id": "displayName", "value": "Next IP 1" }]
          },
          {
            "matcher": { "id": "byName", "options": "ip2" },
            "properties": [{ "id": "displayName", "value": "Next IP 2" }]
          },
          {
            "matcher": { "id": "byName", "options": "ip3" },
            "properties": [{ "id": "displayName", "value": "Next IP 3" }]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "shared": true, "__tenant_id": true, "prom_id": true },
            "renameByName": {
              "network": "Network CIDR",
              "vlan": "VLAN",
              "zone": "Zone",
              "site": "Site",
              "members": "Grid Member",
              "auto_provision": "Auto-Provision",
              "l2": "L2",
              "comment": "Comment"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "IP Capacity by Network",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max by (network, vlan, zone, site, members) (ibx_network_used_ips{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"})",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "max by (network, vlan, zone, site, members) (ibx_network_total_ips{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"})",
          "instant": true,
          "format": "table",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "align": "auto" }
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": {
              "network": "Network CIDR",
              "vlan": "VLAN",
              "zone": "Zone",
              "Value": "Used IPs",
              "Value #B": "Total IPs"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Utilization Trend",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max by (network, vlan) (ibx_network_utilization_percent{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"})",
          "legendFormat": "{{network}} VLAN={{vlan}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 8,
      "title": "Avg Utilization by Zone",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "avg by (zone) (max by (network, zone) (ibx_network_utilization_percent{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"}))",
          "legendFormat": "{{zone}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Utilization Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max by (network) (ibx_network_utilization_percent{zone=~\"$zone\", vlan=~\"$vlan\", site=~\"$site\", network=~\"$network\"})",
          "legendFormat": "All Networks",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["infoblox", "network", "utilization", "dhcp"],
  "templating": {
    "list": [
      {
        "name": "zone",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(ibx_network_utilization_percent, zone)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "label": "Zone"
      },
      {
        "name": "vlan",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(ibx_network_utilization_percent, vlan)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "label": "VLAN"
      },
      {
        "name": "site",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(ibx_network_utilization_percent, site)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "label": "Site"
      },
      {
        "name": "network",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(ibx_network_utilization_percent, network)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "label": "Network"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Infoblox Network Utilization",
  "uid": "ibx-network-utilization",
  "version": 1
}
